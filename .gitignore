# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
dist-*/
web-build/
*.tgz
.expo-shared/

# Native projects
#
# android/ is committed on purpose: it holds the Gradle tweaks (version
# injection, release signing) that this repo relies on, and committing it keeps
# local builds working without a prebuild step. Only its build output is ignored.
#
# ios/ is NOT committed. It is generated by `expo prebuild --platform ios` on the
# macOS runner, because Pods and the Xcode project are only fully valid when
# generated on a Mac.
ios/
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
android/local.properties
android/.idea/
.gradle/

# Signing material. None of this may ever reach the public repository.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
google-services.json

# ...except the React Native debug key, which is a shared, public constant with a
# hardcoded password in the template. Excluding it would break debug builds.
!android/app/debug.keystore

# Local signing credentials. keystore.properties holds the release keystore
# password in plaintext, so it must never be committed.
android/keystore.properties
android/release.keystore

# Secrets
.env
.env.*
eas-build-local.json

# Local scratch
build-inspect/
expo-go-qr.png
build-log.txt
*.log

.DS_Store
Thumbs.db

# Personal build notes. These reference local absolute paths, the signing setup
# and a third-party Apple account, so they stay on this machine rather than in the
# public repository.
GETTING-STARTED.md
CI-SETUP.md
LOCAL-BUILDS.md
